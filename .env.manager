# ─────────────────────────────────────────────────────────────────────────────
# Dracarys — local Docker setup
#
# Steps:
#   1. Copy this file to .env
#   2. Fill in SECRET_KEY and GROQ_API_KEY
#   3. Run: docker compose up --build
#   4. Open: http://localhost:3000
# ─────────────────────────────────────────────────────────────────────────────

# Django secret key — any random string, minimum 50 characters
SECRET_KEY=replace-this-with-any-long-random-string-at-least-50-characters-long

# Groq — REQUIRED. Free key at https://console.groq.com
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Tavily — optional. Web search toggle won't work without it.
# Free key at https://app.tavily.com
TAVILY_API_KEY=

# ── Do not change anything below this line ───────────────────────────────────
USE_CREW_AI=true
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
DOCS_DIR=/app/docs
CHROMA_DB_PATH=/app/chroma_db
